# Copy to `.env.local` and adjust if the backend is not on :8080.
# API_URL is read by server code (route handlers, server components).
# NEXT_PUBLIC_API_URL is what would be exposed to the browser — we don't
# currently need it there because all backend calls are proxied through
# /api/auth/*, but it's wired up for future direct-fetch components.
API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
